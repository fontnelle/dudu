#!/usr/bin/env bash
# dudu: backup and restore of your dev environment (installs, runtimes, terminal config).
# https://github.com/fontnelle/dudu

VERSION="0.2.0"

set -o pipefail

# Follows symlinks (e.g. /usr/local/bin/dudu -> /usr/local/lib/dudu/dudu) without readlink -f.
resolve_root() {
  local src="${BASH_SOURCE[0]}" dir
  while [ -L "$src" ]; do
    dir=$(cd -P "$(dirname "$src")" && pwd)
    src=$(readlink "$src")
    case "$src" in /*) ;; *) src="$dir/$src" ;; esac
  done
  cd -P "$(dirname "$src")" && pwd
}

DUDU_ROOT=$(resolve_root)

load_libs() {
  local f
  for f in "$DUDU_ROOT"/lib/core/*.sh "$DUDU_ROOT"/lib/collectors/*.sh \
           "$DUDU_ROOT"/lib/destinations/*.sh "$DUDU_ROOT"/bin/*.sh; do
    # shellcheck source=/dev/null
    . "$f"
  done
}

load_libs

# "  dudu backup              Save installs..." with the command padded by characters.
usage_row() { # <command> <description>
  printf '  %s %s\n' "$(pad "$1" 24)" "$2"
}

usage() {
  printf '%sdudu%s %s: %s\n\n' "$BOLD" "$NC" "$VERSION" "$(t "back up and restore your dev setup.")"
  printf '%s%s%s\n' "$BOLD" "$(t "Usage")" "$NC"
  usage_row "dudu" "$(t "Interactive menu")"
  usage_row "dudu backup" "$(t "Save installs & configs to your destination")"
  usage_row "dudu restore" "$(t "Reinstall everything on this machine")"
  usage_row "dudu status" "$(t "What changed since the last backup")"
  usage_row "dudu outdated [--all]" "$(t "Check updates for your tools (read-only)")"
  usage_row "dudu secrets" "$(t "Keys found in your config files")"
  usage_row "dudu schedule on [HH:MM]" "$(t "Back up every day (%s)" "off | status")"
  usage_row "dudu config" "$(t "Choose destination & what to include")"
  usage_row "dudu update" "$(t "Update dudu itself")"
  printf '  %s\n' "dudu completion zsh|bash|highlight"
  usage_row "" "$(t "Print shell completion or highlighting")"
  printf '\n%s%s%s\n' "$BOLD" "$(t "Options")" "$NC"
  usage_row "--dry-run" "$(t "Show what would happen, change nothing")"
  usage_row "--only brew,node" "$(t "Limit to some collectors")"
  usage_row "--from <host>" "$(t "(restore) Use the backup of another machine")"
  usage_row "--file <dir>" "$(t "(restore) Use a backup folder directly")"
  usage_row "-y, --yes" "$(t "(restore) Do not ask for confirmation")"
  usage_row "--debug" "$(t "Trace every step into the log")"
  usage_row "-v, --version" "$(t "Print version")"
  echo
  printf '%s %s\n' "$(t "Collectors:")" "$(echo "$DUDU_COLLECTORS" | tr ' ' ',')"
  printf '%s %s\n' "$(t "Language:")" "$(i18n_name "$DUDU_LANG_ACTIVE") (dudu config set language auto|en|pt-BR|es)"
  printf '%s %s\n' "$(t "Docs:")" "$DUDU_HOMEPAGE"
}

main_header() {
  show_banner
  update_notice
  echo
}

main_menu() {
  if [ ! -t 0 ] || [ ! -t 1 ]; then
    usage
    return 0
  fi
  check_for_updates_bg
  while true; do
    MENU_FOOTER="↑↓  |  Enter  |  $(t "V Version")  |  $(t "Q Quit")"
    MENU_HOTKEYS="v"
    menu_select main_header \
      "$(t "Backup")|$(t "Save installs & configs")" \
      "$(t "Restore")|$(t "Reinstall on a new machine")" \
      "$(t "Status")|$(t "What changed since last backup")" \
      "$(t "Outdated")|$(t "Check updates for your tools")" \
      "$(t "Secrets")|$(t "Keys found in your config files")" \
      "$(t "Settings")|$(t "Destinations, language, encryption, schedule")" || break
    # A menu can stay open for hours: pick up code changed since (edits, dudu update).
    load_libs
    clear_screen
    case "$MENU_CHOICE" in
      0) cmd_backup ;;
      1) cmd_restore ;;
      2) cmd_status ;;
      3) cmd_outdated ;;
      4) cmd_secrets ;;
      # Settings is a menu of its own, with its own way back.
      5) cmd_config; dudu_unlock; continue ;;
      -1) [ "$MENU_KEY" = v ] && printf 'dudu %s\n' "$VERSION" ;;
    esac
    printf '\n%s%s%s' "$GRAY" "$(t "Press any key to return to the menu…")" "$NC"
    read -rsn1 _
  done
  clear_screen
}

debug_on() {
  printf '\n=== debug %s, bash %s ===\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$BASH_VERSION" >> "$DUDU_LOG"
  if [ "${BASH_VERSINFO[0]}" -ge 5 ] || { [ "${BASH_VERSINFO[0]}" -eq 4 ] && [ "${BASH_VERSINFO[1]}" -ge 1 ]; }; then
    exec 9>>"$DUDU_LOG"
    BASH_XTRACEFD=9
    PS4='+ ${BASH_SOURCE##*/}:${LINENO}: '
    set -x
  else
    # bash 3.2 cannot send the trace elsewhere than stderr.
    printf 'dudu: %s\n' "$(t "--debug needs bash 4.1+ (brew install bash); logging steps only")" >&2
  fi
}

main() {
  # Everything dudu writes (backups, logs, temp files) is readable by this user only.
  umask 077
  i18n_init
  mkdir -p "$DUDU_CACHE_DIR"
  [ -f "$DUDU_LOG" ] && chmod 600 "$DUDU_LOG" 2>/dev/null
  log_rotate
  trap 'dudu_cleanup' EXIT
  trap 'dudu_cleanup; echo; exit 130' INT
  trap 'dudu_cleanup; exit 143' TERM

  # --debug (or DUDU_DEBUG=1) traces every command into the log.
  local a args=()
  for a in "$@"; do
    if [ "$a" = --debug ]; then DUDU_DEBUG=1; else args+=("$a"); fi
  done
  set -- ${args[@]+"${args[@]}"}
  [ -n "${DUDU_DEBUG:-}" ] && debug_on

  local cmd="${1:-}"
  [ $# -gt 0 ] && shift
  case "$cmd" in
    "") main_menu ;;
    backup)
      local rc=0
      cmd_backup "$@" || rc=$?
      if [ -n "${DUDU_SCHEDULED:-}" ] && [ $rc -ne 0 ]; then
        if [ $rc -eq 2 ]; then schedule_notify "$(t "Backup saved with problems, see dudu status")"
        else schedule_notify "$(t "Backup failed, see %s" "$(tilde "$DUDU_LOG")")"; fi
      fi
      return $rc
      ;;
    restore) cmd_restore "$@" ;;
    status) cmd_status "$@" ;;
    outdated) cmd_outdated "$@" ;;
    secrets) cmd_secrets "$@" ;;
    schedule) cmd_schedule "$@" ;;
    config|settings) cmd_config "$@" ;;
    update) cmd_update "$@" ;;
    completion) cmd_completion "$@" ;;
    -v|--version|version) printf 'dudu %s\n' "$VERSION" ;;
    -h|--help|help) usage ;;
    *) err "$(t "Unknown command: %s" "$cmd")"; echo; usage; exit 1 ;;
  esac
}

main "$@"
